{
  "uid": "oliveira-api-overview",
  "title": "Oliveira API - Overview",
  "description": "Request rate, errors, latency and the business counters of the Oliveira API. Source of the metric names: docs/operations/observability.md.",
  "tags": ["oliveira", "api"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{job=\"oliveira-api\"}, http_route)",
          "refId": "route"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second, by route",
      "description": "Rate of responses per Fastify route template. Requests to an unknown path match no route and are grouped as (no route).",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"oliveira-api\", http_route=~\"$route\"}[$__rate_interval])), \"http_route\", \"(no route)\", \"http_route\", \"\")",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate",
      "description": "Share of responses that were 5xx (server errors, what the alert watches) and 4xx (client errors: bad input, no session, rate limit).",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "5xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "4xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_request_duration_seconds_count{job=\"oliveira-api\", http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"oliveira-api\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "expr": "100 * (sum(rate(http_server_request_duration_seconds_count{job=\"oliveira-api\", http_route=~\"$route\", http_response_status_code=~\"4..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"oliveira-api\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "4xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "p50, p95 and p99 of request duration, estimated from the histogram buckets.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"oliveira-api\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"oliveira-api\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"oliveira-api\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "heatmap",
      "title": "Request duration distribution",
      "description": "How many requests fell in each duration bucket over time. A second band of slow requests shows up here long before it moves the p95.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "fill": "dark-orange",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 64,
          "reverse": false
        },
        "yAxis": { "axisPlacement": "left", "unit": "s" },
        "rowsFrame": { "layout": "auto" },
        "tooltip": { "mode": "single", "yHistogram": false },
        "legend": { "show": true }
      },
      "targets": [
        {
          "refId": "A",
          "format": "heatmap",
          "expr": "sum by (le) (increase(http_server_request_duration_seconds_bucket{job=\"oliveira-api\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Login attempts, by outcome",
      "description": "auth.login.attempts. There is one failure outcome for every reason on purpose - the response does not say why a login failed, and neither does this metric.",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(auth_login_attempts_total{job=\"oliveira-api\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Person changes, by operation",
      "description": "person.changes: records created, updated or deleted (a bulk delete of ten counts ten).",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (increase(person_changes_total{job=\"oliveira-api\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Warnings and errors",
      "description": "WARN and ERROR lines from the API. Open a line and use the Trace link on trace_id to jump to the request in Tempo.",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"oliveira-api\"} | detected_level=~\"warn|error\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
