{
  "name": "oliveira-erp",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test:unit": "vitest run",
    "test:api": "playwright test --config=tests/api/playwright.config.ts",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts --headed --workers=1",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
