/// The client is generated as plain source into apps/api (git-ignored, rebuilt
/// by `npm run db:generate`) rather than into node_modules — Prisma 7's
/// `prisma-client` generator requires an explicit output. ESM with `.js` import
/// specifiers, to match how apps/api is compiled and run.
generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

/// The connection URL lives in prisma.config.ts (Prisma 7), not here.
///
/// The `pg_trgm` extension behind the two `gin_trgm_ops` indexes on Person is
/// created by migration 20260731050843 (`CREATE EXTENSION IF NOT EXISTS`); the
/// `postgresqlExtensions` preview feature that used to declare it here is
/// deprecated. Those indexes make `GET /api/persons?search=`'s `contains`
/// (Prisma's ILIKE) hit an index instead of a sequential scan.
datasource db {
  provider = "postgresql"
}

/// Kept as database enums rather than free text so an invalid value is
/// rejected by Postgres, not only by the Zod schema in packages/schemas —
/// anything writing to this table directly used to be able to store "BANANA".
enum DocumentType {
  CPF
  CNPJ
}

/// Renamed from PersonType, with USER/EMPLOYEE added — see migration
/// 2 for why this is a separate step from the Person.types column change.
enum PersonTypeValue {
  CLIENT
  SUPPLIER
  USER
  EMPLOYEE
}

/// Role on the Platform itself (docs/adr/0018) — not what the person does in a
/// company or in a product. SUPER_ADMIN is the Oliveira team: it administers
/// companies and contracts and has no access to any product or company data
/// unless it also holds a membership and a seat like anyone else. A company's
/// own administrator is a Membership.role, not an AccountRole. SYSTEM is
/// reserved for integrations/jobs and cannot sign in interactively.
enum AccountRole {
  SUPER_ADMIN
  USER
  SYSTEM
}

/// The products the Platform gives access to. A product is code (routes,
/// screens, guards), so adding one is a migration — an enum, like
/// DocumentType, rather than a table nothing could fill on its own.
enum Product {
  ERP
  FSM
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum ContractStatus {
  ACTIVE
  SUSPENDED
}

model Person {
  id           String            @id @default(uuid())
  name         String
  /// Contact e-mail — deliberately separate from AccessAccount.email (the
  /// login credential); the two can legitimately diverge.
  email        String?
  phone        String?
  birthdate    DateTime?
  /// Multiple roles at once (a company can be both a client and a supplier).
  /// USER marks a person that has an AccessAccount.
  types        PersonTypeValue[]
  /// Required only when `types` contains CLIENT or SUPPLIER — enforced by
  /// personCreateSchema/personFormSchema in packages/schemas, not by the DB.
  documentType DocumentType?
  document     String?
  active       Boolean           @default(true)
  street       String?
  city         String?
  state        String?
  zipCode      String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  account AccessAccount?

  @@unique([document, documentType])
  @@index([types])
  @@index([active])
  // The default `findMany` order (`person.service.ts`) and every other
  // sort column already round out with `id` as a tie-breaker, but
  // `createdAt` itself is what most listings actually sort/page by.
  @@index([createdAt])
  // The plain B-tree still earns its keep for `ORDER BY name` (sorting the
  // People grid by name) and exact/prefix lookups — a GIN index doesn't
  // accelerate sorting at all, only WHERE-clause matching.
  @@index([name])
  // `gin_trgm_ops`: makes `GET /api/persons?search=`'s `contains` (Prisma's
  // ILIKE `'%term%'`) use an index instead of a sequential table scan — a
  // B-tree can't accelerate a leading-wildcard match.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Person_name_trgm_idx")
  @@index([document(ops: raw("gin_trgm_ops"))], type: Gin, map: "Person_document_trgm_idx")
}

/// Credentials only — no cadastral data lives here, that's Person's job.
/// Deactivating access (or deleting the account once that's supported)
/// never touches the person's history.
model AccessAccount {
  id       Int      @id @default(autoincrement())
  personId String   @unique
  person   Person   @relation(fields: [personId], references: [id])
  /// The login credential. Kept separate from Person.email on purpose.
  email    String   @unique
  /// Reserved for ERP-style login by username — not used for authentication
  /// yet; e-mail is the credential today (see docs/product/access_control.md).
  login    String?  @unique
  password String
  active   Boolean  @default(true)
  role     AccountRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles        AccountProfile[]
  gridPreferences GridColumnPreference[]
  memberships     Membership[]
  grantedAccesses ProductAccess[]        @relation("ProductAccessGrantedBy")
}

/// A customer company of the Oliveira Platform. Deliberately global for now:
/// business tables are not company-scoped until the isolation work (#60), so
/// exactly one company may exist until then and nothing provisions another
/// (docs/adr/0018).
model Company {
  id        String        @id @default(uuid(7))
  legalName String
  tradeName String?
  /// CNPJ. Unique when present.
  document  String?       @unique
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberships Membership[]
  products    CompanyProduct[]
}

/// An account's place in a company. `role` is the company's own administrator
/// flag, independent of AccountRole. Until company switching exists an account
/// may have only one ACTIVE membership; the API enforces it.
model Membership {
  id        String           @id @default(uuid(7))
  accountId Int
  account   AccessAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  role      MembershipRole   @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  productAccess ProductAccess[]

  @@unique([accountId, companyId])
  @@index([companyId])
}

/// The contract: a product a company may use, and how many members may use it
/// at once (`seatLimit`, null = unlimited). Written by the Oliveira team, never
/// by the company's own administrator.
model CompanyProduct {
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product
  status    ContractStatus @default(ACTIVE)
  seatLimit Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@id([companyId, product])
}

/// A seat: the company's administrator let this member into a product. The
/// product's own profiles and permissions decide what they do there — nothing
/// in this table says so.
model ProductAccess {
  membershipId String
  membership   Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  product      Product
  /// Null when the seed created it.
  grantedById  Int?
  grantedBy    AccessAccount? @relation("ProductAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt    DateTime       @default(now())

  @@id([membershipId, product])
}

/// Business permissions, not technical role — "what does this account holder
/// do", as opposed to AccountRole's "is this a system administrator". A
/// company defines its own profiles (Administrator, Manager, Finance,
/// Cashier…); AccountRole.ADMIN bypasses this check entirely (see
/// docs/product/access_control.md), so a profile named "Administrator" is a
/// *business* role, not the same thing as an ADMIN account.
model AccessProfile {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  /// System-seeded profiles (Administrator, Default User) can't be deleted
  /// — deleting the only profile a login flow depends on would break it.
  isSystem    Boolean  @default(false)
  /// The profile linked to a member the first time they are granted a seat in
  /// the ERP (registration itself grants nothing). Exactly one profile should
  /// have this set — enforced by the seed script, not the DB.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions ProfilePermission[]
  accounts    AccountProfile[]
}

/// The permission catalog is sealed — rows here only ever come from the
/// system's own catalog (packages/schemas/src/permissions.ts), seeded by
/// prisma/seed.ts. Nothing in the product ever lets a user create one; they
/// only attach existing permissions to a profile.
model Permission {
  id       Int     @id @default(autoincrement())
  resource String
  action   String
  label    String?

  profiles ProfilePermission[]

  @@unique([resource, action])
}

model ProfilePermission {
  profileId    Int
  permissionId Int
  profile      AccessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([profileId, permissionId])
}

/// The account↔profile link kept as its own entity ("Access Control")
/// rather than an implicit many-to-many — the extension point for scoping
/// access later (per company/branch/department) without touching Person or
/// AccessProfile at all, just adding a column here.
model AccountProfile {
  id         Int           @id @default(autoincrement())
  accountId  Int
  profileId  Int
  account    AccessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profile    AccessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assignedAt DateTime      @default(now())

  @@unique([accountId, profileId])
}

/// A listing screen's column show/hide + order, saved per account. `gridKey`
/// is a stable identifier the screen chooses (e.g. "person-list") — the same
/// table serves every future listing without a new model per screen.
/// `columns` is the ordered array itself (`{ key, visible }[]`); the shape is
/// validated by `gridColumnPreferenceSaveSchema` in packages/schemas, not by
/// the database.
model GridColumnPreference {
  id        Int           @id @default(autoincrement())
  accountId Int
  account   AccessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  gridKey   String
  columns   Json
  updatedAt DateTime      @updatedAt

  @@unique([accountId, gridKey])
}
