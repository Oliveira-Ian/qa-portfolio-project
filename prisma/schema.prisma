/// The client is generated as plain source into apps/api (git-ignored, rebuilt
/// by `npm run db:generate`) rather than into node_modules — Prisma 7's
/// `prisma-client` generator requires an explicit output. ESM with `.js` import
/// specifiers, to match how apps/api is compiled and run.
generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

/// The connection URL lives in prisma.config.ts (Prisma 7), not here.
///
/// The `pg_trgm` extension behind the two `gin_trgm_ops` indexes on Person is
/// created by migration 20260731050843 (`CREATE EXTENSION IF NOT EXISTS`); the
/// `postgresqlExtensions` preview feature that used to declare it here is
/// deprecated. Those indexes make `GET /api/persons?search=`'s `contains`
/// (Prisma's ILIKE) hit an index instead of a sequential scan.
datasource db {
  provider = "postgresql"
}

/// Kept as database enums rather than free text so an invalid value is
/// rejected by Postgres, not only by the Zod schema in packages/schemas —
/// anything writing to this table directly used to be able to store "BANANA".
enum DocumentType {
  CPF
  CNPJ
}

/// Renamed from PersonType, with USER/EMPLOYEE added — see migration
/// 2 for why this is a separate step from the Person.types column change.
enum PersonTypeValue {
  CLIENT
  SUPPLIER
  USER
  EMPLOYEE
}

/// Role on the Platform itself (docs/adr/0018) — not what the person does in a
/// company or in a product. SUPER_ADMIN is the Oliveira team: it administers
/// companies and contracts and has no access to any product or company data
/// unless it also holds a membership and a seat like anyone else. A company's
/// own administrator is a Membership.role, not an AccountRole. SYSTEM is
/// reserved for integrations/jobs and cannot sign in interactively.
enum AccountRole {
  SUPER_ADMIN
  USER
  SYSTEM
}

/// The products the Platform gives access to. A product is code (routes,
/// screens, guards), so adding one is a migration — an enum, like
/// DocumentType, rather than a table nothing could fill on its own.
enum Product {
  ERP
  FSM
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum ContractStatus {
  ACTIVE
  SUSPENDED
}

/// The company's registry of people and organisations — customers, suppliers,
/// employees. Company data: `companyId` is NOT NULL and the table is under
/// row-level security (docs/adr/0012), so a company never sees another's rows.
///
/// A Person is not an identity. The account that signs in is AccessAccount,
/// which holds its own display name; a member's record in a company's registry
/// is linked from Membership.personId, per company (docs/adr/0013).
model Person {
  id                    String            @id @default(uuid(7))
  companyId             String
  company               Company           @relation(fields: [companyId], references: [id])
  name                  String
  /// Contact e-mail — deliberately separate from AccessAccount.email (the
  /// login credential); the two can legitimately diverge.
  email                 String?
  phone                 String?
  mobile                String?
  /// Trade name (nome fantasia) of a company; the legal name is `name`.
  tradeName             String?
  stateRegistration     String?
  municipalRegistration String?
  birthdate             DateTime?
  /// Multiple roles at once (a company can be both a client and a supplier).
  /// The ERP's classification; products never extend it (docs/adr/0011). USER is
  /// legacy — new accounts no longer set it (docs/adr/0013).
  types                 PersonTypeValue[]
  /// Required only when `types` contains CLIENT or SUPPLIER — enforced by
  /// personCreateSchema/personFormSchema in packages/schemas, not by the DB.
  documentType          DocumentType?
  document              String?
  active                Boolean           @default(true)
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  /// Members of this company whose registry record this is.
  memberships Membership[]
  /// Its addresses — one primary. For the FSM, also its service locations.
  addresses   Address[]
  /// The people to talk to there.
  contacts    Contact[]
  /// Its role as a customer of Oliveira FSM, when it has one (docs/adr/0019).
  customer    Customer?

  /// Target of composite foreign keys `(companyId, personId)`: a row of one
  /// company can never point at a person of another, even through a bug.
  @@unique([companyId, id])
  /// A document is unique within a company, not across the Platform.
  @@unique([companyId, document, documentType])
  @@index([companyId, types])
  @@index([companyId, active])
  // The default `findMany` order (`person.service.ts`) and every other
  // sort column already round out with `id` as a tie-breaker, but
  // `createdAt` itself is what most listings actually sort/page by.
  @@index([companyId, createdAt])
  // `ORDER BY name` (sorting the People grid by name) and prefix lookups.
  @@index([companyId, name])
  // `gin_trgm_ops` makes `contains` (ILIKE `'%term%'`) use an index — for a
  // role that bypasses RLS. Under the policy the planner cannot use it, because
  // ILIKE is not leakproof, and the search runs as a filter over the company's
  // rows instead (measured in the #60 spike, docs/adr/0012).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Person_name_trgm_idx")
  @@index([document(ops: raw("gin_trgm_ops"))], type: Gin, map: "Person_document_trgm_idx")
}

/// The Platform identity: one login, valid in every company the account is a
/// member of. Global on purpose — it is read before any company is known — so it
/// is not under row-level security. It holds only what identifies the person
/// signing in; a company's record of them is a Person, linked per company from
/// Membership.personId (docs/adr/0013).
model AccessAccount {
  id       Int         @id @default(autoincrement())
  /// Display name of the person signing in.
  name     String
  /// The login credential. Kept separate from Person.email on purpose.
  email    String      @unique
  /// Reserved for ERP-style login by username — not used for authentication
  /// yet; e-mail is the credential today (see docs/product/access_control.md).
  login    String?     @unique
  password String
  active   Boolean     @default(true)
  role     AccountRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gridPreferences GridColumnPreference[]
  memberships     Membership[]
  grantedAccesses ProductAccess[]        @relation("ProductAccessGrantedBy")
}

/// A customer company of the Oliveira Platform — the unit of isolation. Every
/// business table carries its id and is under row-level security
/// (docs/adr/0012); this table itself is Platform data and is not.
model Company {
  id                    String        @id @default(uuid(7))
  legalName             String
  tradeName             String?
  /// CNPJ. Unique when present.
  document              String?       @unique
  status                CompanyStatus @default(ACTIVE)
  /// The rest of the registration — central Platform data, edited by the
  /// company's account administrator on the Platform; legal name and CNPJ
  /// only by Oliveira (plan § 2.9). One main address, as columns: this table is
  /// read before any company is in context, outside row-level security.
  stateRegistration     String?
  municipalRegistration String?
  email                 String?
  phone                 String?
  website               String?
  zipCode               String?
  street                String?
  number                String?
  complement            String?
  district              String?
  city                  String?
  state                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  memberships    Membership[]
  products       CompanyProduct[]
  persons        Person[]
  profiles       AccessProfile[]
  branches       Branch[]
  customers      Customer[]
  equipment      Equipment[]
  catalogItems   CatalogItem[]
  workOrderTypes WorkOrderType[]
}

/// A place a company operates from (docs/adr/0013, addendum of 2026-11-10).
/// Foundation data shared by every product, managed inside the products with
/// their own permissions. No access is restricted by branch and nothing is the
/// session's "active branch" — a later restriction would be a column on
/// MembershipProfile. Company data under row-level security. A branch something
/// points at is deactivated rather than deleted.
model Branch {
  id                String   @id @default(uuid(7))
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  /// Short identifier the company chooses ("SP-01"), unique within it.
  code              String
  name              String
  /// CNPJ of the branch, when it has its own.
  document          String?
  stateRegistration String?
  email             String?
  phone             String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// Its address (the forms keep one; the table allows more later).
  addresses Address[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@index([companyId, name])
}

enum AddressType {
  COMMERCIAL
  RESIDENTIAL
  BILLING
  SERVICE
  DELIVERY
  OTHER
}

/// An address of the company's registry (plan § 2.9, the essential of F-14):
/// owned by exactly one Person or one Branch (a CHECK in the migration), typed,
/// one primary per owner (a partial unique index). Updated in place — never
/// deleted and recreated — so what points at it (equipment, work orders) keeps
/// pointing at it. Company data under row-level security.
model Address {
  id         String      @id @default(uuid(7))
  companyId  String
  personId   String?
  branchId   String?
  person     Person?     @relation(fields: [companyId, personId], references: [companyId, id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Cascade)
  type       AddressType @default(COMMERCIAL)
  /// "Head office", "Plant 2" — how the owner tells its addresses apart.
  label      String?
  isPrimary  Boolean     @default(false)
  zipCode    String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  /// "Next to the bakery", "gate 3" — for whoever drives there.
  reference  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  /// Equipment installed here.
  equipment Equipment[]

  @@unique([companyId, id])
  @@index([companyId, personId])
  @@index([companyId, branchId])
}

/// A person to talk to at a customer or supplier, beyond the record's own main
/// email and phone. Company data under row-level security.
model Contact {
  id        String   @id @default(uuid(7))
  companyId String
  personId  String
  person    Person   @relation(fields: [companyId, personId], references: [companyId, id], onDelete: Cascade)
  name      String
  /// Job title or department.
  role      String?
  email     String?
  phone     String?
  mobile    String?
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, id])
  @@index([companyId, personId])
}

/// An account's place in a company. `role` is the company's own administrator
/// flag, independent of AccountRole. Until company switching exists an account
/// may have only one ACTIVE membership; the API enforces it.
model Membership {
  id        String           @id @default(uuid(7))
  accountId Int
  account   AccessAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  role      MembershipRole   @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  /// This member's record in the company's registry, when there is one —
  /// optional and per company (docs/adr/0013). `Restrict`: deleting the person
  /// behind a login is refused rather than silently unlinking it.
  personId  String?
  person    Person?          @relation(fields: [companyId, personId], references: [companyId, id], onDelete: Restrict)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  productAccess ProductAccess[]
  profiles      MembershipProfile[]

  @@unique([accountId, companyId])
  @@unique([companyId, id])
  @@unique([companyId, personId])
  @@index([companyId])
}

/// The contract: a product a company may use, and how many members may use it
/// at once (`seatLimit`, null = unlimited). Written by the Oliveira team, never
/// by the company's own administrator.
model CompanyProduct {
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product
  status    ContractStatus @default(ACTIVE)
  seatLimit Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@id([companyId, product])
}

/// A seat: the company's administrator let this member into a product. The
/// product's own profiles and permissions decide what they do there — nothing
/// in this table says so.
model ProductAccess {
  membershipId String
  membership   Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  product      Product
  /// Null when the seed created it.
  grantedById  Int?
  grantedBy    AccessAccount? @relation("ProductAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt    DateTime       @default(now())

  @@id([membershipId, product])
}

/// What a member may do inside one product — the fourth authorization layer
/// (docs/adr/0018). Each company has its own profiles per product: the
/// reference ones are copied in when the company contracts the product
/// (`prisma/reference-profiles.ts`), and the company edits, duplicates and adds
/// to them. An ERP profile only ever holds ERP permissions, an FSM profile FSM
/// ones. Company data, under row-level security (docs/adr/0012).
model AccessProfile {
  id          Int      @id @default(autoincrement())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  product     Product
  name        String
  description String?
  /// Reference profiles that can't be deleted — the product's Administrator,
  /// and the default profile a first seat links.
  isSystem    Boolean  @default(false)
  /// The profile linked to a member the first time they are granted a seat in
  /// this product (registration itself grants nothing). One per company and
  /// product — enforced by the provisioning, not the DB.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions ProfilePermission[]
  members     MembershipProfile[]

  @@unique([companyId, id])
  /// Target of MembershipProfile's key: the link carries the profile's product.
  @@unique([companyId, id, product])
  @@unique([companyId, product, name])
  @@index([companyId, product])
}

/// The permission catalog is sealed — rows here only ever come from the
/// system's own catalog (packages/schemas/src/permissions.ts), seeded by
/// prisma/seed.ts. Nothing in the product ever lets a user create one; they
/// only attach existing permissions to a profile. Global: the same catalog for
/// every company, one section per product.
model Permission {
  id       Int     @id @default(autoincrement())
  product  Product
  resource String
  action   String
  label    String?

  profiles ProfilePermission[]

  @@unique([product, resource, action])
}

/// Carries the company too, so its row-level security policy is a plain
/// column comparison, and its composite key ties it to a profile of the same
/// company.
model ProfilePermission {
  companyId    String
  profileId    Int
  permissionId Int
  profile      AccessProfile @relation(fields: [companyId, profileId], references: [companyId, id], onDelete: Cascade)
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([profileId, permissionId])
  @@index([companyId])
}

/// A member's profile in one product of a company — per membership, not per
/// account, so the same login can do different things in different companies;
/// **one per product** (`@@unique([membershipId, product])`). `product` repeats
/// the profile's and is part of the foreign key, so the database itself refuses
/// a link whose product disagrees with its profile. Kept as its own entity so
/// scoping a profile further (to a branch, later) is a column here, without
/// touching Membership or AccessProfile.
model MembershipProfile {
  id           String        @id @default(uuid(7))
  companyId    String
  membershipId String
  product      Product
  profileId    Int
  membership   Membership    @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: Cascade)
  profile      AccessProfile @relation(fields: [companyId, profileId, product], references: [companyId, id, product], onDelete: Cascade)
  assignedAt   DateTime      @default(now())

  @@unique([companyId, id])
  @@unique([membershipId, product])
  @@index([companyId, profileId])
}

/// A listing screen's column show/hide + order, saved per account. `gridKey`
/// is a stable identifier the screen chooses (e.g. "person-list") — the same
/// table serves every future listing without a new model per screen.
/// `columns` is the ordered array itself (`{ key, visible }[]`); the shape is
/// validated by `gridColumnPreferenceSaveSchema` in packages/schemas, not by
/// the database.
model GridColumnPreference {
  id        Int           @id @default(autoincrement())
  accountId Int
  account   AccessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  gridKey   String
  columns   Json
  updatedAt DateTime      @updatedAt

  @@unique([accountId, gridKey])
}

// ---------------------------------------------------------------------------
// Oliveira FSM (docs/especificacoes/fsm-v1.md). Company data under row-level
// security, composite foreign keys (docs/adr/0012), UUID v7.
// ---------------------------------------------------------------------------

/// A customer of Oliveira FSM: a Person of the company, with its contacts and
/// addresses, marked as served by the FSM. The FSM never touches `Person.types`
/// (the ERP's classification, docs/adr/0011 and 0019). Inactivating a customer
/// is `Person.active`.
model Customer {
  id        String   @id @default(uuid(7))
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  personId  String
  person    Person   @relation(fields: [companyId, personId], references: [companyId, id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment[]

  @@unique([companyId, id])
  @@unique([companyId, personId])
}

enum EquipmentStatus {
  ACTIVE
  UNDER_MAINTENANCE
  INACTIVE
}

/// A customer's equipment, installed at one of the customer's addresses (the
/// service checks the address belongs to it). Work orders build its history.
model Equipment {
  id            String          @id @default(uuid(7))
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  customerId    String
  customer      Customer        @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  addressId     String?
  address       Address?        @relation(fields: [companyId, addressId], references: [companyId, id], onDelete: Restrict)
  /// Where exactly, at that address: "machine room, 3rd floor".
  location      String?
  name          String
  /// The company's own tag or asset number, unique within it.
  tag           String?
  category      String?
  manufacturer  String?
  model         String?
  serialNumber  String?
  installedAt   DateTime?       @db.Date
  warrantyUntil DateTime?       @db.Date
  status        EquipmentStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([companyId, id])
  @@unique([companyId, tag])
  @@index([companyId, customerId])
  @@index([companyId, name])
}

enum CatalogItemKind {
  PRODUCT
  SERVICE
}

/// A product or service the company uses or performs in the field — what a
/// work order records as materials and services. No stock balance in the V1.
model CatalogItem {
  id          String          @id @default(uuid(7))
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  kind        CatalogItemKind
  code        String?
  name        String
  description String?
  /// "UN", "M", "H", "KG"…
  unit        String          @default("UN")
  price       Decimal?        @db.Decimal(12, 2)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@index([companyId, name])
}

/// What kind of work a work order is: installation, preventive maintenance…
/// Reference types are copied into a company when it contracts the FSM; then
/// they are the company's to edit.
model WorkOrderType {
  id          String   @id @default(uuid(7))
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, id])
  @@unique([companyId, name])
}
