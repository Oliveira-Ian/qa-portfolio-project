DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oliveira_erp?schema=public"

# Read by prisma/seed.ts. Bootstraps the first ADMIN account — left unset
# here on purpose (leave commented out to skip creating one; the seed is safe
# to re-run later once these are set).
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="change-me"

# Also read by prisma/seed.ts. Defaults to system@oliveira.internal if unset —
# only needs overriding if that address collides with a real account.
# SYSTEM_ACCOUNT_EMAIL="system@oliveira.internal"
