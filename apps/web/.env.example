# Copy this file to .env.local (Next.js convention) when running apps/web
# alongside apps/api locally — see docs/index.md Quick Start.
#
# Read only on the server (Server Actions, data-access) — never exposed to the
# browser, unlike the old NEXT_PUBLIC_API_URL. The browser never talks to
# apps/api directly anymore; every request is proxied through a Server Action
# or a Server Component fetch.
API_URL="http://localhost:3001"
