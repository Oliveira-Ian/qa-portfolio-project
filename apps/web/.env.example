# Copy this file to .env.local (Next.js convention) when running apps/web
# alongside apps/api locally — see docs/index.md Quick Start.
#
# Read only on the server (Server Actions, data-access) — never exposed to the
# browser, unlike the old NEXT_PUBLIC_API_URL. The browser never talks to
# apps/api directly anymore; every request is proxied through a Server Action
# or a Server Component fetch.
API_URL="http://localhost:3001"

# Where the server-side traces go (docs/operations/observability.md). Optional:
# with nothing listening, the exporter drops its data quietly.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# Public sign-up (the /register page and the link on the login page). Off unless
# "true" — set it together with the API's PUBLIC_REGISTRATION_ENABLED.
# PUBLIC_REGISTRATION_ENABLED=false

# The public demo (docs/operations/environments.md): with DEMO_MODE=true the login
# page shows these credentials and a button that fills them in. Demo host only.
# DEMO_MODE=true
# DEMO_LOGIN_EMAIL="demo@demo.oliveira.app"
# DEMO_LOGIN_PASSWORD="<the demo account's password>"
