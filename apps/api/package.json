{
  "name": "@oliveira/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit false",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/otel": "^0.21.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@oliveira/schemas": "*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pino": "^0.68.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@prisma/instrumentation": "~7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1"
