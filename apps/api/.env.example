DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oliveira_erp"
PORT=3000

# Signs and verifies session JWTs (apps/api/src/modules/auth/token.ts).
# Left unset here on purpose — commenting it out (not setting it to an empty
# string) lets the dev-only default apply. Set a real value before deploying;
# boot fails if the default is still in place with NODE_ENV=production.
# JWT_SECRET=
# Anything jose accepts: 30m, 8h, 7d. Defaults to 8h if unset.
# JWT_EXPIRES_IN=8h

# Comma-separated allowlist for @fastify/cors. apps/web never calls this API
# from the browser, so this only matters for a browser hitting it directly
# (Swagger UI's "Try it out", or manual debugging). Defaults to apps/web's
# own origin if unset.
# CORS_ORIGINS=http://localhost:3000

# Minimum level the logger writes: fatal, error, warn, info, debug, trace or silent.
# LOG_LEVEL=info

# Telemetry (docs/operations/observability.md). Read by the OpenTelemetry SDK
# itself, not by env.ts, so they are optional and unvalidated. With nothing
# listening the API runs the same; the exporters drop their data quietly.
# Collector to push to; this is where `npm run obs:up` listens.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=oliveira-api
# Turns telemetry off entirely.
# OTEL_SDK_DISABLED=true
